# Firebase Web App configuration (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to true only after enabling Google provider in Firebase Authentication.
VITE_FIREBASE_GOOGLE_ENABLED=false
VITE_DATA_URL_IMAGE_MAX_BYTES=524288

# V1 private Blob limits, applied by the server before upload.
V1_BLOB_MAX_IMAGE_BYTES=5242880
V1_BLOB_MAX_PDF_BYTES=5242880

# Server-only migration values. Never expose these with a VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=./your-firebase-adminsdk-key.json
FIREBASE_DATABASE_ID=(default)
FIREBASE_SERVICE_ACCOUNT_JSON=
