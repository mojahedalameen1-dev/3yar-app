rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function owner() { return signedIn() && resource.data.user_id == request.auth.uid; }
    function incomingOwner() { return signedIn() && request.resource.data.user_id == request.auth.uid; }

    function ownsCar(carId) {
      return signedIn()
        && exists(/databases/$(database)/documents/cars/$(carId))
        && get(/databases/$(database)/documents/cars/$(carId)).data.user_id == request.auth.uid;
    }
    function ownsActiveCar(carId) {
      return ownsCar(carId)
        && get(/databases/$(database)/documents/cars/$(carId)).data.deletion_requested != true;
    }
    function ownsChild() {
      return owner() && ownsCar(resource.data.car_id);
    }
    function incomingOwnedChild() {
      return incomingOwner() && ownsActiveCar(request.resource.data.car_id);
    }
    function carOwnerCanUpdate() {
      return owner() && incomingOwner() && (
        resource.data.deletion_requested != true
        || (request.resource.data.deletion_requested == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletion_requested', 'updated_at']))
      );
    }
    // Share tokens are issued/revoked by the authenticated server API only.
    // Unrelated client updates may preserve existing legacy sharing fields.
    function clientCarShareCreateSafe() {
      return request.resource.data.get('public_share_enabled', false) == false
        && request.resource.data.get('share_token', null) == null;
    }
    function clientCarShareFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['public_share_enabled', 'share_token']);
    }

    match /profiles/{profileId} {
      allow read: if admin() || owner();
      allow create: if admin() || (incomingOwner() && request.resource.data.role == 'user');
      allow update: if admin() || (owner() && incomingOwner() && request.resource.data.role == resource.data.role);
      allow delete: if admin() || owner();
    }

    match /app_config/{configId} {
      allow read, write: if admin();
    }

    match /cars/{carId} {
      allow read: if admin() || owner();
      allow create: if clientCarShareCreateSafe()
        && (admin() || (incomingOwner() && request.resource.data.deletion_requested != true));
      allow update: if clientCarShareFieldsUnchanged() && (admin() || carOwnerCanUpdate());
      allow delete: if admin() || owner();
    }

    match /maintenance_tasks/{taskId} {
      allow read: if admin() || ownsChild();
      allow create: if admin() || incomingOwnedChild();
      allow update: if admin() || (ownsChild() && incomingOwnedChild() && request.resource.data.car_id == resource.data.car_id);
      allow delete: if admin() || ownsChild();
    }

    match /maintenance_records/{recordId} {
      allow read: if admin() || ownsChild();
      allow create: if admin() || incomingOwnedChild();
      allow update: if admin() || (ownsChild() && incomingOwnedChild() && request.resource.data.car_id == resource.data.car_id);
      allow delete: if admin() || ownsChild();
    }

    match /documents/{documentId} {
      allow read: if admin() || ownsChild();
      allow create: if admin() || incomingOwnedChild();
      allow update: if admin() || (ownsChild() && incomingOwnedChild() && request.resource.data.car_id == resource.data.car_id);
      allow delete: if admin() || ownsChild();
    }

    match /odometer_readings/{readingId} {
      allow read: if admin() || ownsChild();
      allow create: if admin() || incomingOwnedChild();
      allow update: if admin() || (ownsChild() && incomingOwnedChild() && request.resource.data.car_id == resource.data.car_id);
      allow delete: if admin() || ownsChild();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if admin();
    }

    match /announcement_reads/{readId} {
      allow read, delete: if admin() || owner();
      allow create: if admin() || incomingOwner();
      allow update: if admin() || (owner() && incomingOwner());
    }

    match /activity_logs/{logId} {
      allow read: if admin();
      allow create: if admin() || incomingOwner();
      allow update, delete: if admin();
    }

    match /default_maintenance_templates/{templateId} {
      allow read: if true;
      allow write: if admin();
    }
  }
}
