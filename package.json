{
  "name": "car-maintenance-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-firebase-preview.mjs && vite build",
    "preview": "vite preview",
    "lint:check": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --project demo-3yar-rules --only firestore \"npm run test:rules:emulator\"",
    "test:rules:emulator": "vitest run tests/rules",
    "test:phase0b:emulator": "firebase emulators:exec --project demo-3yar-phase0b --only firestore \"vitest run tests/emulator\"",
    "audit:supabase:read-only": "node scripts/audit-supabase-legacy-readiness.mjs --target=legacy-supabase-read-only --expected-supabase-ref=koljxracpdgiqbxaiapc --expected-firebase-project=yar-3yar-free",
    "migrate:firebase": "node scripts/migrate-supabase-to-firebase.mjs",
    "firebase:set-admin": "node scripts/set-firebase-admin.mjs",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vercel/blob": "^2.8.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.10",
    "firebase": "^12.19.0",
    "firebase-admin": "13.6.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.4.0",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.2.5",
    "vuetify": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@supabase/supabase-js": "^2.91.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.7.0",
    "firebase-tools": "^15.30.2",
    "prettier": "^3.8.1",
    "sass": "^1.69.5",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vuetify": "^2.0.1",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "dompurify": "^3.2.4"
  }
}
